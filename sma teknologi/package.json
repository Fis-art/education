{
  "name": "smk-teknologi-plus",
  "version": "1.0.0",
  "private": true,
  "description": "Website Profil SMK Teknologi Plus - Monorepo",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspaces",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "test:coverage": "npm run test:coverage --workspaces",
    "db:migrate": "npm run migrate --workspace=backend",
    "db:migrate:rollback": "npm run migrate:rollback --workspace=backend",
    "db:seed": "npm run seed --workspace=backend",
    "db:reset": "npm run migrate:reset --workspace=backend && npm run seed --workspace=backend",
    "db:studio": "npm run db:studio --workspace=backend",
    "prepare": "husky install",
    "clean": "rimraf node_modules frontend/node_modules backend/node_modules frontend/dist backend/dist"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "husky": "^8.0.3",
    "rimraf": "^5.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}